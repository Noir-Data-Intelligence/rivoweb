{
  "name": "rivoweb",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:types": "openapi-typescript openapi/v1.json -o src/lib/api/schema.d.ts",
    "api:check": "node scripts/check-api-types.mjs",
    "tokens:check": "node scripts/check-tokens.mjs",
    "e2e": "playwright test --project=chromium --project=firefox --project=webkit",
    "licenses": "license-checker-rseidelsohn --production --onlyAllow \"MIT;ISC;BSD-2-Clause;BSD-3-Clause;Apache-2.0;0BSD;OFL-1.1\" --excludePrivatePackages",
    "e2e:producao": "playwright test --project=leitura-producao",
    "smoke:leitura": "node scripts/smoke-leitura.mjs",
    "serve:dist": "node scripts/serve-dist.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run tokens:check && npm run api:check",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "5.104.2",
    "big.js": "7.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.55.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "react-router": "8.4.0",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/big.js": "7.0.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.4",
    "autoprefixer": "10.6.1",
    "eslint": "10.12.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "license-checker-rseidelsohn": "5.0.1",
    "msw": "3.0.3",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.30",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
